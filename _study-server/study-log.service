[Unit]
Description=Study log storage server
After=network.target

[Service]
EnvironmentFile=%h/.config/study-log.env
ExecStart=/usr/bin/env python3 %h/.local/lib/study-log/study_server.py --allow-user ${STUDY_LOG_USER}
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
