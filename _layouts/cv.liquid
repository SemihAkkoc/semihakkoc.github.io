---
layout: default
---
{% comment %}
  Unified CV layout that handles both RenderCV (YAML) and JSONResume (JSON) formats
  - If page.cv_format is set, it determines which format to render:
    - 'rendercv': Load and render only RenderCV data (site.data.cv.cv)
    - 'jsonresume': Load and render only JSONResume data (site.data.resume)
  - If page.cv_format is not set, RenderCV is prioritized if both exist
  Both formats use the same section renderer (_includes/cv/section.liquid)
{% endcomment %}

{% assign render_rendercv = false %}
{% assign render_jsonresume = false %}
{% if page.cv_format == 'rendercv' %}
  {% assign render_rendercv = true %}
{% elsif page.cv_format == 'jsonresume' %}
  {% assign render_jsonresume = true %}
{% elsif site.data.cv and site.data.cv.cv %}
  {% assign render_rendercv = true %}
{% elsif site.data.resume %}
  {% assign render_jsonresume = true %}
{% endif %}

<div class="post ed-page cv-page">
  <header class="post-header ed-page-header">
    <span class="ed-section-number">{{ page.label | default: page.title }}</span>
    <h1 class="post-title">{{ page.heading | default: page.title }}</h1>
    <hr class="ed-section-rule">
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
    {% if page.cv_pdf or page.resume_pdf %}
      <div class="ed-header-actions">
        {% if page.cv_pdf %}
          <a
            class="ed-btn"
            href="{% if page.cv_pdf contains '://' %}{{ page.cv_pdf }}{% else %}{{ page.cv_pdf | relative_url }}{% endif %}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fa-solid fa-arrow-down"></i> Full CV (PDF)
          </a>
        {% endif %}
        {% if page.resume_pdf %}
          <a
            class="ed-btn ed-btn-outline"
            href="{% if page.resume_pdf contains '://' %}{{ page.resume_pdf }}{% else %}{{ page.resume_pdf | relative_url }}{% endif %}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fa-solid fa-arrow-down"></i> One-page resume
          </a>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article class="cv">
    {% if render_rendercv and site.data.cv and site.data.cv.cv %}
      {% assign cv = site.data.cv.cv %}

      {% if cv.summary %}
        <div class="cv-summary">{{ cv.summary | markdownify }}</div>
      {% endif %}

      {% for section_pair in cv.sections %}
        {% assign section_title = section_pair[0] %}
        {% assign entries = section_pair[1] %}
        {% include cv/section.liquid title=section_title %}
      {% endfor %}

    {% elsif render_jsonresume and site.data.resume %}
      {% assign resume = site.data.resume %}

      {% if resume.basics.summary %}
        <div class="cv-summary">{{ resume.basics.summary | markdownify }}</div>
      {% endif %}

      {% assign empty_array = '' | split: ',' %}
      {% assign work = resume.work | default: empty_array %}
      {% assign vol = resume.volunteer | default: empty_array %}
      {% assign entries = work | concat: vol %}
      {% include cv/section.liquid title='Experience' kind='experience' %}

      {% assign entries = resume.education %}
      {% include cv/section.liquid title='Education' kind='education' %}

      {% assign entries = resume.awards %}
      {% include cv/section.liquid title='Awards' kind='awards' %}

      {% assign entries = resume.publications %}
      {% include cv/section.liquid title='Publications' kind='publications' %}

      {% assign entries = resume.skills %}
      {% include cv/section.liquid title='Skills' kind='skills' %}

      {% assign entries = resume.languages %}
      {% include cv/section.liquid title='Languages' kind='languages' %}

      {% assign entries = resume.interests %}
      {% include cv/section.liquid title='Interests' kind='interests' %}

      {% assign entries = resume.certificates %}
      {% include cv/section.liquid title='Certificates' kind='certificates' %}

      {% assign entries = resume.projects %}
      {% include cv/section.liquid title='Projects' kind='projects' %}

      {% assign entries = resume.references %}
      {% include cv/section.liquid title='References' kind='references' %}
    {% endif %}
  </article>
</div>
