<script>
  document.documentElement.classList.add("js");
</script>
{% if page.full_width %}
  {% assign nav_prefix = '' %}
{% else %}
  {% assign nav_prefix = '/' | relative_url %}
{% endif %}
<header>
  <nav id="navbar" class="ed-nav{% if page.full_width %} ed-nav--autohide{% endif %}" role="navigation" aria-label="Main">
    <div class="ed-nav-inner">
      <a class="ed-nav-logo" href="{{ '/' | relative_url }}#top">
        {%- if site.title == 'blank' -%}
          {{ site.first_name }} {{ site.last_name }}
        {%- else -%}
          {{ site.title }}
        {%- endif -%}
      </a>
      <div class="ed-nav-links">
        {% for item in site.data.navigation.sections %}
          <a href="{{ nav_prefix }}#{{ item.id }}" data-section="{{ item.id }}">{{ item.title }}</a>
        {% endfor %}
        {% if site.data.socials.cv_pdf %}
          <a href="{{ site.data.socials.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer" class="ed-nav-cv">CV ↗</a>
        {% endif %}
      </div>
      <div class="ed-nav-tools">
        {% if site.enable_darkmode %}
          <button id="light-toggle" title="Change theme" aria-label="Change theme">
            <i class="fa-half-sun-moon" id="light-toggle-system"></i>
            <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
            <i class="fa-solid fa-sun" id="light-toggle-light"></i>
          </button>
        {% endif %}
        <button class="ed-nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-controls="mobileNav" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </nav>

  <div class="ed-mobile-nav" id="mobileNav">
    {% for item in site.data.navigation.sections %}
      <a href="{{ nav_prefix }}#{{ item.id }}">{{ item.title }}</a>
    {% endfor %}
    {% if site.data.socials.cv_pdf %}
      <a href="{{ site.data.socials.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer">CV ↗</a>
    {% endif %}
  </div>
</header>
