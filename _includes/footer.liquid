<footer class="ed-footer" role="contentinfo">
  <div class="ed-footer-inner">
    <span class="ed-footer-text">
      &copy; {{ site.time | date: '%Y' }}
      {{ site.data.cv.cv.name | default: site.title }}.
      {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </span>
    <a href="#top" class="ed-footer-top">&uarr; Back to top</a>
  </div>
</footer>
<script defer src="{{ '/assets/js/editorial.js' | relative_url | bust_file_cache }}"></script>
