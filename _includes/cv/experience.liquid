{% comment %}
  Unified work/experience entry renderer for both RenderCV and JSONResume formats
  Handles both:
  - RenderCV: company, position, start_date, end_date, location, url, summary, highlights
  - JSONResume: name, position, startDate, endDate, location, url, summary, highlights
{% endcomment %}

<div class="cv-entries">
  {% for entry in entries %}
    {% capture company_name %}{% if entry.name %}{{ entry.name }}{% elsif entry.company %}{{ entry.company }}{% elsif entry.organization %}{{ entry.organization }}{% endif %}{% endcapture %}
    <div class="cv-entry">
      <div class="cv-entry-meta">
        <span class="cv-date">
          {%- include cv/date_range.liquid start=entry.start_date end=entry.end_date -%}
          {%- include cv/date_range.liquid start=entry.startDate end=entry.endDate -%}
        </span>
        {% if entry.location %}
          <span class="cv-location"><i class="fa-solid fa-location-dot"></i> {{ entry.location }}</span>
        {% endif %}
      </div>
      <div class="cv-entry-main">
        <h3 class="cv-entry-title" data-toc-skip>
          {% if entry.url %}
            <a href="{{ entry.url }}">{{ entry.position | default: company_name }}</a>
          {% else %}
            {{ entry.position | default: company_name }}
          {% endif %}
        </h3>
        {% if entry.position and company_name != '' %}
          <div class="cv-entry-org">{{ company_name }}</div>
        {% endif %}
        {% if entry.summary %}
          <div class="cv-entry-sub">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
        {% endif %}
        {% if entry.highlights %}
          <ul class="cv-highlights">
            {% for item in entry.highlights %}
              <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
