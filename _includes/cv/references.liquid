{% comment %}
  Unified references entry renderer for both formats
{% endcomment %}

<div class="cv-entries">
  {% for entry in entries %}
    <div class="cv-entry cv-entry-full">
      <div class="cv-entry-main">
        <h3 class="cv-entry-title" data-toc-skip>
          {% if entry.icon %}
            <i class="{{ entry.icon }}"></i>
          {% endif %}
          {{ entry.name }}
        </h3>
        <div class="cv-entry-text">{{ entry.reference | markdownify }}</div>
      </div>
    </div>
  {% endfor %}
</div>
