{% comment %}
  Unified awards entry renderer for both formats
{% endcomment %}

<div class="cv-entries">
  {% for entry in entries %}
    <div class="cv-entry">
      <div class="cv-entry-meta">
        <span class="cv-date">{{ entry.date | append: '' | split: '-' | first }}</span>
      </div>
      <div class="cv-entry-main">
        <h3 class="cv-entry-title" data-toc-skip>
          {% if entry.url %}
            <a href="{{ entry.url }}">{{ entry.title }}</a>
          {% else %}
            {{ entry.title }}
          {% endif %}
        </h3>
        {% if entry.awarder %}
          <div class="cv-entry-org">{{ entry.awarder }}</div>
        {% endif %}
        {% if entry.summary %}
          <p class="cv-entry-text">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
