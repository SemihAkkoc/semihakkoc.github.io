{% comment %}
  Unified certificates entry renderer for both formats
{% endcomment %}

<div class="cv-entries">
  {% for entry in entries %}
    <div class="cv-entry">
      <div class="cv-entry-meta">
        <span class="cv-date">{{ entry.date | append: '' | split: '-' | first }}</span>
      </div>
      <div class="cv-entry-main">
        <h3 class="cv-entry-title" data-toc-skip>
          {% if entry.icon %}
            <i class="{{ entry.icon }}"></i>
          {% endif %}
          {% if entry.url %}
            <a href="{{ entry.url }}">{{ entry.name }}</a>
          {% else %}
            {{ entry.name }}
          {% endif %}
        </h3>
        {% if entry.issuer %}
          <div class="cv-entry-org">{{ entry.issuer }}</div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
