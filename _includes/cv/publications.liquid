{% comment %}
  Unified publications entry renderer for both formats
  - RenderCV: title, authors, journal, date, url, doi
  - JSONResume: name, publisher, releaseDate, url, summary
{% endcomment %}

<div class="cv-entries">
  {% for entry in entries %}
    {% capture pub_date %}{% if entry.releaseDate %}{{ entry.releaseDate }}{% elsif entry.date %}{{ entry.date }}{% endif %}{% endcapture %}
    {% capture pub_url %}{% if entry.url %}{{ entry.url }}{% elsif entry.doi %}https://doi.org/{{ entry.doi }}{% endif %}{% endcapture %}
    <div class="cv-entry">
      <div class="cv-entry-meta">
        <span class="cv-date">{{ pub_date | split: '-' | first }}</span>
      </div>
      <div class="cv-entry-main">
        <h3 class="cv-entry-title" data-toc-skip>
          {% if pub_url != '' %}
            <a href="{{ pub_url }}">{{ entry.title | default: entry.name }}</a>
          {% else %}
            {{ entry.title | default: entry.name }}
          {% endif %}
        </h3>
        {% if entry.authors %}
          <div class="cv-entry-authors">
            {{ entry.authors | join: ', ' | markdownify | remove: '<p>' | remove: '</p>' }}
          </div>
        {% endif %}
        {% if entry.journal or entry.publisher %}
          <div class="cv-entry-sub">{{ entry.journal | default: entry.publisher }}</div>
        {% endif %}
        {% if entry.summary %}
          <p class="cv-entry-text">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
