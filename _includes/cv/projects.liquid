{% comment %}
  Unified projects entry renderer for both formats
{% endcomment %}

<div class="cv-entries">
  {% for entry in entries %}
    <div class="cv-entry cv-entry-full">
      <div class="cv-entry-main">
        <h3 class="cv-entry-title" data-toc-skip>
          {% if entry.url %}
            <a href="{{ entry.url }}">{{ entry.name }}</a>
          {% else %}
            {{ entry.name }}
          {% endif %}
        </h3>
        {% if entry.summary %}
          <p class="cv-entry-text">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
        {% if entry.highlights %}
          <ul class="cv-highlights">
            {% for item in entry.highlights %}
              <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
