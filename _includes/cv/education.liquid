{% comment %}
  Unified education entry renderer for both RenderCV and JSONResume formats
  Handles both:
  - RenderCV: institution, area, studyType (or degree), start_date, end_date, location, courses, highlights
  - JSONResume: institution, area, studyType, startDate, endDate, location, courses, highlights
  Short highlights (GPA, advisor, ...) are shown inline; courses as a list.
{% endcomment %}

<div class="cv-entries">
  {% for entry in entries %}
    {% capture study_type %}{% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}{% endcapture %}
    <div class="cv-entry">
      <div class="cv-entry-meta">
        <span class="cv-date">
          {%- include cv/date_range.liquid start=entry.start_date end=entry.end_date -%}
          {%- include cv/date_range.liquid start=entry.startDate end=entry.endDate -%}
        </span>
        {% if entry.location %}
          <span class="cv-location"><i class="fa-solid fa-location-dot"></i> {{ entry.location }}</span>
        {% endif %}
      </div>
      <div class="cv-entry-main">
        <h3 class="cv-entry-title" data-toc-skip>
          {% if entry.url %}
            <a href="{{ entry.url }}">{{ entry.institution }}</a>
          {% else %}
            {{ entry.institution }}
          {% endif %}
        </h3>
        {% if study_type != '' or entry.area %}
          <div class="cv-entry-org">
            {{ study_type }}
            {%- if study_type != '' and entry.area %}, {% endif -%}
            {{ entry.area }}
          </div>
        {% endif %}
        {% if entry.score %}
          <div class="cv-entry-sub">GPA: {{ entry.score }}</div>
        {% endif %}
        {% if entry.highlights %}
          <ul class="cv-facts">
            {% for item in entry.highlights %}
              <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if entry.courses %}
          <ul class="cv-highlights">
            {% for item in entry.courses %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
