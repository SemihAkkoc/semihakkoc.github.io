{% comment %}
  Unified interests entry renderer for both formats
{% endcomment %}

<div class="cv-skill-groups">
  {% for entry in entries %}
    <div class="cv-skill-group">
      <div class="cv-skill-name">
        {% if entry.icon %}
          <i class="{{ entry.icon }}"></i>
        {% endif %}
        {{ entry.name }}
      </div>
      {% if entry.keywords %}
        {% assign keywords = entry.keywords | join: ', ' | split: ', ' %}
        <ul class="chips">
          {% for keyword in keywords %}
            <li class="chip">{{ keyword }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>
