{% comment %}
  Unified languages entry renderer for both formats
  - RenderCV uses: name, summary (or language, fluency)
  - JSONResume uses: language, fluency
{% endcomment %}

<ul class="cv-languages">
  {% for entry in entries %}
    <li>
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      <span class="cv-language-name">{{ entry.language | default: entry.name }}</span>
      <span class="cv-language-level">{{ entry.fluency | default: entry.summary }}</span>
    </li>
  {% endfor %}
</ul>
